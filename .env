# ============================================
# 小O帮帮 - 环境变量配置
# 企业级生产环境配置
# ============================================

# ============================================
# 应用基础配置
# ============================================
APP_NAME=小O帮帮
APP_NAME_EN=OHelper
APP_VERSION=3.0.0
BUILD_NUMBER=300
PACKAGE_NAME=com.omaster.app

# ============================================
# API服务器配置
# ============================================
# 主API服务器地址
API_BASE_URL=https://api.ohelper.app/v1/

# 预设数据CDN地址
PRESET_BASE_URL=https://cdn.ohelper.app/presets/v2/
PRESET_OPPO_URL=https://cdn.ohelper.app/presets/v2/oppo.json
PRESET_REALME_URL=https://cdn.ohelper.app/presets/v2/realme.json
PRESET_HONOR_URL=https://cdn.ohelper.app/presets/v2/honor.json
PRESET_VIVO_URL=https://cdn.ohelper.app/presets/v2/vivo.json

# Web调试控制台地址
WEB_DEBUG_URL=https://debug.ohelper.app

# ============================================
# 数据库配置
# ============================================
# 主数据库
DB_HOST=db.ohelper.app
DB_PORT=5432
DB_NAME=ohelper_production
DB_USER=ohelper_app
DB_PASSWORD=your-secure-db-password

# Redis缓存
REDIS_HOST=redis.ohelper.app
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-redis-password
REDIS_DB=0

# ============================================
# 安全密钥配置
# ============================================
# JWT密钥 - 生产环境必须使用强随机字符串
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# 加密密钥
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# API密钥
API_KEY=your-secure-api-key

# ============================================
# 文件存储配置
# ============================================
# 对象存储
OSS_ENDPOINT=oss.ohelper.app
OSS_BUCKET=ohelper-assets
OSS_ACCESS_KEY=your-oss-access-key
OSS_SECRET_KEY=your-oss-secret-key

# 本地存储路径
UPLOAD_DIR=/data/uploads
LOGS_DIR=/data/logs
CACHE_DIR=/data/cache

# ============================================
# 邮件服务配置
# ============================================
SMTP_HOST=smtp.ohelper.app
SMTP_PORT=587
SMTP_USER=noreply@ohelper.app
SMTP_PASSWORD=your-smtp-password
SMTP_SECURE=true

# ============================================
# 推送通知配置
# ============================================
# FCM推送
FCM_SERVER_KEY=your-fcm-server-key

# 华为推送
HUAWEI_APP_ID=your-huawei-app-id
HUAWEI_APP_SECRET=your-huawei-app-secret

# 小米推送
XIAOMI_APP_ID=your-xiaomi-app-id
XIAOMI_APP_SECRET=your-xiaomi-app-secret

# OPPO推送
OPPO_APP_KEY=your-oppo-app-key
OPPO_APP_SECRET=your-oppo-app-secret

# ============================================
# 第三方服务配置
# ============================================
# 阿里云
ALICLOUD_ACCESS_KEY=your-alicloud-access-key
ALICLOUD_SECRET_KEY=your-alicloud-secret-key

# 腾讯云
TENCENT_CLOUD_SECRET_ID=your-tencent-secret-id
TENCENT_CLOUD_SECRET_KEY=your-tencent-secret-key

# 百度AI
BAIDU_AI_API_KEY=your-baidu-ai-key
BAIDU_AI_SECRET_KEY=your-baidu-ai-secret

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_MAX_SIZE=100m
LOG_MAX_FILES=30

# ============================================
# 性能配置
# ============================================
CACHE_SIZE_LIMIT_MB=500
CACHE_EXPIRY_DAYS=30
SYNC_INTERVAL_HOURS=24
MAX_UPLOAD_SIZE_MB=50

# ============================================
# 功能开关
# ============================================
ENABLE_AI_SCENE_DETECTION=true
ENABLE_CLOUD_SYNC=true
ENABLE_PUSH_NOTIFICATION=true
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true

# ============================================
# 开发环境配置
# ============================================
DEBUG=false
ENABLE_LOGGING=false
ENABLE_MOCK_DATA=false
