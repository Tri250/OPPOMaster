<?xml version="1.0" encoding="utf-8"?>
<!--
    OMaster 数据提取规则
    SIG-SEC-003: 应用完整性配置
    PERM-SEC-003: 数据提取安全
    Android 12+ (API 31+) 专用
-->
<data-extraction-rules>
    <!-- 云端备份规则 -->
    <cloud-backup>
        <!-- 排除敏感数据 -->
        <exclude domain="sharedpref" path="secure_prefs.xml"/>
        <exclude domain="sharedpref" path="encrypted_api_key.xml"/>
        <exclude domain="database" path="secure_database"/>
        
        <!-- 排除安全相关文件 -->
        <exclude domain="file" path="sensitive_data/"/>
        
        <!-- 排除临时文件 -->
        <exclude domain="cache" path="*"/>
        
        <!-- 包含必要的用户数据 -->
        <include domain="sharedpref" path="presets.xml"/>
        <include domain="sharedpref" path="settings.xml"/>
        <include domain="database" path="presets.db"/>
    </cloud-backup>
    
    <!-- 设备传输规则 -->
    <device-transfer>
        <!-- 包含所有必要的用户数据 -->
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
        <include domain="file" path="presets/"/>
        
        <!-- 排除敏感数据 -->
        <exclude domain="sharedpref" path="secure_prefs.xml"/>
        <exclude domain="sharedpref" path="encrypted_api_key.xml"/>
    </device-transfer>
</data-extraction-rules>
