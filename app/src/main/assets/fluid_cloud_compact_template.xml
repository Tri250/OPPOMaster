{
  "uiData": {
    "title": "预设名称",
    "subtitle": "ISO 100 | 1/125",
    "scoreText": "4.8",
    "iconPath": "assets/images/camera_icon.png",
    "coverImage": "assets/images/cover.png",
    "bgGradient": "linear-gradient(180deg,#6366F1,#8B5CF6)",
    "borderColor": "#8B5CF6",
    "applyText": "应用预设",
    "cameraParams": {
      "iso": "ISO: 100",
      "shutter": "快门: 1/125",
      "ev": "EV: +0.3",
      "contrast": "对比度: 1.1",
      "saturation": "饱和度: 1.0",
      "wb": "白平衡: 5600K"
    }
  },
  "uiEvent": {}
}
