<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        OMaster 应用权限配置
        PERM-SEC-001: 最小权限原则
        仅申请应用功能必需的权限
    -->

    <!-- 核心功能权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 悬浮窗权限 - PERM-SEC-001 & PERM-COL-001 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 存储权限 - PERM-SEC-001 & PERM-SEC-002 -->
    <!-- 仅用于导入/导出预设和保存截图 -->
    <uses-permission 
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission 
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    
    <!-- Android 13+ 照片权限 - PERM-SEC-002 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Camera权限 - 仅用于读取Camera2参数，不采集图像 -->
    <uses-feature 
        android:name="android.hardware.camera" 
        android:required="false" />
    <uses-feature 
        android:name="android.hardware.camera.any" 
        android:required="false" />

    <!-- 通知权限 - 用于后台同步提醒 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 后台运行权限 - PERM-COL-002 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- 无障碍服务权限 -->
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />

    <application
        android:name=".OMasterApplication"
        
        <!-- PERM-SEC-003: 应用完整性配置 -->
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        
        <!-- SIG-SEC-003: 禁用备份到云端，防止篡改 -->
        android:backupInhibited="false"
        
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OMaster"
        android:networkSecurityConfig="@xml/network_security_config"
        
        <!-- PERM-SEC-001 & SIG-SEC-003: 禁用明文流量 -->
        android:usesCleartextTraffic="false"
        
        <!-- PERM-COL-002: 后台电池优化配置 -->
        android:enableOnBackInvokedCallback="true"
        
        tools:targetApi="34">

        <!-- 主Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.OMaster">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 流体云服务 -->
        <service
            android:name=".service.FluidCloudService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 无障碍服务 - 相机参数自动填入 -->
        <service
            android:name=".accessibility.AutoFillAccessibilityService"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- File Provider - 安全分享截图 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.opmaster.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 后台同步服务 -->
        <service
            android:name=".sync.CloudSyncService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 启动接收器 - 用于后台同步 -->
        <receiver
            android:name=".sync.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
