# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,cpp,cu,cuh,h,hpp,m,mm}]
indent_size = 4

[*.{cmake,txt}]
indent_size = 2

[CMakeLists.txt]
indent_size = 2

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.{qml,js,mjs}]
indent_size = 4

[*.{proto}]
indent_size = 2

[*.{rs}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{py,pyi}]
indent_size = 4

[Makefile]
indent_style = tab

[*.sh]
indent_size = 2

[*.{ps1,cmd}]
indent_size = 4
end_of_line = crlf
